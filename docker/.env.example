# Copiar a .env (dev) o .env.production (prod) y completar valores reales.
# NUNCA commitear el .env real al repo.

# --- Postgres ---
POSTGRES_USER=sosafrotman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sosafrotman_dev

# --- Backend / seguridad ---
ENV=development
SECRET_KEY=changeme-genera-uno-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
